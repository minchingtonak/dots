#!/usr/bin/env bash

set -Eeuo pipefail

# install custom branch of vesktop that implements basic mute/deafen keybinds

mk () {
	mkdir -p "$1" && cd "$1" || exit
}

mktmp () {
	mk "/tmp/mktmp-$(date '+%y%m%d-%H%M')"
}

mktmp

git clone https://github.com/PolisanTheEasyNick/Vesktop
cd Vesktop
git switch keybinds

# patch the implementation to allow keybinds on non-wayland display protocols
patch -u src/main/mainWindow.ts <<EOF
--- src/main/mainWindow.ts	2024-08-25 10:13:55.911533943 -0700
+++ src/main/mainWindowPatched.ts	2024-08-25 20:24:34.852867390 -0700
@@ -499,5 +499,5 @@
     });

     initArRPC();
-    if (isWayland) initKeybinds();
+    initKeybinds();
 }
EOF

npx pnpm i

npx pnpm package --linux pacman

sudo pacman -R vesktop || true

echo "Run: sudo pacman -U $(pwd)/dist/vesktop-X.X.X.pacman"
