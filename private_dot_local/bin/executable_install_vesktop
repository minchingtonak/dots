#!/usr/bin/env bash

set -Eeuo pipefail

# install custom branch of vesktop that implements basic mute/deafen keybinds

mk () {
	mkdir -p "$1" && cd "$1" || exit
}

mktmp () {
	mk "/tmp/mktmp-$(date '+%y%m%d-%H%M%S')"
}

mktmp

git clone https://github.com/mgabor3141/Vesktop
cd Vesktop
git switch keybinds

npx pnpm i

npx pnpm package --linux pacman

sudo pacman -R vesktop || true

echo "Run: sudo pacman -U $(pwd)/dist/vesktop-X.X.X.pacman"
