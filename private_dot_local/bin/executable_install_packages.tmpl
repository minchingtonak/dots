#!/usr/bin/env bash

set -Eeuo pipefail

# get a space-separated list of package names corresponding to the given
# package list name and type (repo|aur)
function getpackages() {
    if [ -z "$1" ]; then
        # shellcheck disable=SC2016
        echo '$1 must not be empty'
        exit 1
    fi

    if [ -z "$2" ]; then
        # shellcheck disable=SC2016
        echo '$2 must not be empty'
        exit 1
    fi

    tr '\n' ' ' <~/.local/bin/packagelists/"$1"/"$2".txt
}

# a package list is a set of repo packages and AUR packages with a name
# see ~/.local/bin/packagelists
function installpackagelist() {
    if [ -z "$1" ]; then
        # shellcheck disable=SC2016
        echo '$1 must not be empty'
        exit 1
    fi

    echo "Attempting to install packages for list '$1'"

    # install repo packages
    PACKAGES=$(getpackages "$1" repo)

    if [ "$PACKAGES" != "#" ]; then
        echo "Installing repo packages for list '$1'"
        # shellcheck disable=SC2086
        yay -S --repo $PACKAGES
    else
        echo "No repo packages to install for list '$1'"
    fi

    # install AUR packages
    AUR_PACKAGES=$(getpackages "$1" aur)

    if [ "$AUR_PACKAGES" != "#" ]; then
        echo "Installing AUR packages for list '$1'"
        # shellcheck disable=SC2086
        yay -S --aur $AUR_PACKAGES
    else
        echo "No AUR packages to install for list '$1'"
    fi
}

# full system upgrade
yay -Syu

# {{ if eq .chezmoi.hostname "eniac" }}

# install laptop-specific packages
installpackagelist laptop

# {{ end }}

installpackagelist common
