#!/usr/bin/env bash

set -Eeuo pipefail

FOLDER="${1:-/home/$USER/wp}"

function refresh() {
    wal -n --saturate 0.75 -i "$FOLDER"

    WALLPAPER_PATH="$(cat ~/.cache/wal/wal)"

    feh --bg-fill "$WALLPAPER_PATH" &

    dispatch_shell_colors &

    # only restart spotify if it was already running
    if pgrep -f /opt/spotify/spotify >/dev/null; then
        launch_spotify &
    fi

    launch_dunst &
    pywalfox update &

    # run pywal-discord commands in sequence to avoid corrupting generated theme files
    {
        pywal-discord -t wal -d
        pywal-discord -t wal -d -p ~/.config/vesktop/themes
    } &
}

# run asynchronously so we don't block rofi from closing if using wallpaper menu
refresh &
