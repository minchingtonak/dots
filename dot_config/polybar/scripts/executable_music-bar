#!/usr/bin/env bash

# Check if player argument is provided
if [ $# -eq 0 ]; then
    # Log warning and fall back to default active player
    echo "Warning: No player specified, using default active player" >&2

    PLAYER=$(playerctl -l 2>/dev/null | head -n1)
    if [ -z "$PLAYER" ]; then
        echo "Error: No active players found" >&2
        echo "Available players:" >&2
        playerctl -l 2>/dev/null || echo "  No players currently running" >&2
        exit 1
    fi
    echo "Using player: $PLAYER" >&2
else
    PLAYER="$1"
fi

VOL="$(playerctl --player="$PLAYER" volume 2>/dev/null | awk '{printf "%.0f%%", $1 * 100}')"

# Set volume icon based on volume level
if [ -z "$VOL" ]; then
    ICON=""
elif [ "${VOL:0:-1}" -gt 66 ]; then
    ICON=""
elif [ "${VOL:0:-1}" -gt 33 ]; then
    ICON=""
elif [ "${VOL:0:-1}" -gt 5 ]; then
    ICON=""
else
    ICON=""
fi

# Get music info using the generalized script with specified player
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
MUSIC_INFO="$(python "$SCRIPT_DIR/music_player.py" --player "$PLAYER" -t 100 -f '{play_pause} {artist} ♪ {song}' -p ',')"

# Output the result
if [ -n "$VOL" ]; then
    echo "$MUSIC_INFO ($ICON $VOL)"
else
    echo "$MUSIC_INFO"
fi