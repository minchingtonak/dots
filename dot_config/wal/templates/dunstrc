# test commands

# sends a progress value, which causes dunst to show a progress bar
# notify-send -h int:value:25  test hellooooooooooooooooooooooooooooooooooooooooooooooooooooooo

# actions just cause dunst to log the name of the action, then you can use the
# logged choice from the user to do different things
# https://gitlab.gnome.org/GNOME/libnotify/-/merge_requests/18
# in this example, 'test-name' is logged after selecting the action
# notify-send --action 'test-name=description' 'This is a notification!

[global]
    monitor = 0
    follow = mouse
    width = (400, 700) # also update progress bar width
    height = (100, 250)
    origin = top-right
    offset = (8, 47)
    indicate_hidden = yes
    shrink = no
    transparency = 0
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    frame_width = 2
    frame_color = "{color2}"
    separator_color = frame
    sort = yes
    idle_threshold = 420
    font = Roboto mono 12
    line_height = 0
    markup = full
    # https://docs.gtk.org/Pango/pango_markup.html
    format = "• <span size="small" rise="1pt" weight="bold" style="italic">%a</span>\n<span size="medium"><b>%s</b>  %p</span>\n<span size="medium">%b</span>"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = true
    icon_position = left
    min_icon_size = 50
    max_icon_size = 75
    icon_corner_radius = 10
    # enable_recursive_icon_lookup = true
    # icon_path = /usr/share/icons/
    sticky_history = no
    history_length = 50
    dmenu = /usr/bin/rofi -dmenu -p dunst:
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 10
    ignore_dbusclose = false
    force_xinerama = false
    mouse_left_click = do_action,close_current
    mouse_middle_click = do_action
    mouse_right_click = close_current
    notification_limit = 10
    progress_bar = true
    progress_bar_height = 10
    progress_bar_corner_radius = 5
    progress_bar_min_width = 400
    progress_bar_max_width = 700
    progress_bar_horizontal_alignment = left
[experimental]
    per_monitor_dpi = false
[urgency_low]
    background = "{background}"
    foreground = "{foreground}"
    timeout = 8
[urgency_normal]
    background = "{background}"
    foreground = "{foreground}"
    timeout = 8
[urgency_critical]
    background = "{background}"
    foreground = "{foreground}"
    frame_color = "#f07178"
