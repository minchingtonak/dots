Host nextcloud
  HostName nextcloud.alecminch.dev
  User root
  IdentityFile ~/.ssh/hetzner_ed25519

Host kubessh.needlestack.net
  User alec
  IdentityFile ~/.ssh/needlestack_ed25519
  ForwardAgent yes
  Port 8022

Host gitlab.needlestack.net
  User git
  IdentityFile ~/.ssh/ns_ed25519

# GitHub.com
Host github.com
  Preferredauthentications publickey
  IdentityFile ~/.ssh/github_ed25519

Host homelab
  HostName 192.168.0.89
  User root
  IdentityFile ~/.ssh/lxc_ed25519

