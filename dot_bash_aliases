# create/attach to zellij session, with a separate tab for each folder
# $1=session name, required
# $2=path to open as workspace, optional, default=.
session() {
  if [ -z "$1" ]; then
    echo 'must provide session name'
    return
  fi

  name="$1"
  root=${2:-$(pwd)}

  if zellij attach "$name"; then
    return # return if session exists or if we can resurrect
  fi

  zellij attach -b "$name"

  dirs=$(find "$root" -maxdepth 1 -type d | tail -n +2 | awk -F'/' '{print $NF}')
  for dir in $(echo "$dirs" | tr '\n' ' '); do
    echo "Adding $dir"
    zellij --session "$name" action new-tab --name "$dir" --cwd "$dir/" --layout "workspace"
  done

  zellij attach "$name"
}

# extract an arbitrary compressed file by filetype
ex() {
  if [ -f "$1" ] ; then
    case "$1" in
      *.tar.bz2)   tar xjf "$1"   ;;
      *.tar.gz)    tar xzf "$1"   ;;
      *.bz2)       bunzip2 "$1"   ;;
      *.rar)       unrar x "$1"   ;;
      *.gz)        gunzip "$1"    ;;
      *.tar)       tar xf "$1"    ;;
      *.tbz2)      tar xjf "$1"   ;;
      *.tgz)       tar xzf "$1"   ;;
      *.zip)       unzip "$1"     ;;
      *.Z)         uncompress "$1";;
      *.7z)        7z x "$1"      ;;
      *)           echo "'$1' cannot be extracted via ex()" ;;
    esac
  else
    echo "'$1' is not a recognized format of compressed file"
  fi
}

